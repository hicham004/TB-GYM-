# TB Gym production settings, read by compose.production.yaml.
#
# On the server: cp .env.production.example .env, then fill in every empty value. docs/GO-LIVE.md
# says where each one comes from. Keep a copy of the filled-in file in your password manager; never
# commit it. Generate secrets on the server with the commands shown (openssl is preinstalled).

# ---------------------------------------------------------------------------
# Domain and HTTPS
# ---------------------------------------------------------------------------
# The address people type, without https://. Its DNS A record must point at this server first.
TB_GYM_DOMAIN=app.example.com
# Let's Encrypt writes here if a certificate is about to expire and renewal keeps failing.
TB_GYM_ACME_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_DB=tbgym
POSTGRES_USER=tbgym
# Letters and digits only:  openssl rand -hex 24
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
TB_GYM_EMAIL_ENABLED=true
# Resend > API Keys > Create (permission: Sending access).
TB_GYM_EMAIL_API_KEY=
# The name and address mail comes from, on the subdomain you verified in Resend.
TB_GYM_EMAIL_FROM="TB Gym <notifications@mail.example.com>"
# Where replies go: your support inbox.
TB_GYM_EMAIL_REPLY_TO=support@example.com
# Resend > Webhooks > Add endpoint https://<your domain>/api/notifications/email/provider-events,
# then copy its signing secret (starts with whsec_).
TB_GYM_EMAIL_WEBHOOK_SECRET=
# Protects the list of addresses that bounced:  openssl rand -base64 32
# Set it once and never change it; rotating means adding a second key (see compose.production.yaml).
TB_GYM_EMAIL_FINGERPRINT_KEY=

# ---------------------------------------------------------------------------
# Progress photos: Cloudflare R2 storage plus the ClamAV upload scanner
# ---------------------------------------------------------------------------
# With photos (recommended, needs an 8 GB server): keep these as they are and fill in the R2 values.
# Without photos (4 GB server is enough): set COMPOSE_PROFILES= (empty), both adapters to None, and
# leave the R2 values empty. Uploads are then refused and everything else works.
COMPOSE_PROFILES=photos
TB_GYM_MEDIA_STORAGE_ADAPTER=R2
TB_GYM_MEDIA_SCANNER_ADAPTER=ClamAv
# The 32-character account id from the Cloudflare dashboard, and the private EU media bucket.
TB_GYM_R2_ACCOUNT_ID=
TB_GYM_R2_BUCKET=
# An R2 API token for the media bucket only, permission Object Read & Write.
TB_GYM_R2_ACCESS_KEY_ID=
TB_GYM_R2_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Backups: every night, encrypted, uploaded to a second bucket, kept 30 days
# ---------------------------------------------------------------------------
# The PUBLIC half of your backup key (starts with age1). Make the key pair on your own computer, not
# on this server: see docs/GO-LIVE.md. The private half never comes to this server.
TB_GYM_BACKUP_AGE_RECIPIENT=
# The backup bucket, and an R2 API token for that bucket only (Object Read & Write).
TB_GYM_BACKUP_BUCKET=
TB_GYM_BACKUP_S3_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com
TB_GYM_BACKUP_S3_ACCESS_KEY_ID=
TB_GYM_BACKUP_S3_SECRET_ACCESS_KEY=
# Another S3-compatible store works too: set its provider name (for example Backblaze or Wasabi),
# endpoint and region instead.
TB_GYM_BACKUP_S3_PROVIDER=Cloudflare
TB_GYM_BACKUP_S3_REGION=auto
TB_GYM_BACKUP_KEEP_DAYS=30
# 0 = midnight UTC, 02:00 or 03:00 in Beirut.
TB_GYM_BACKUP_HOUR_UTC=0
# Optional: a healthchecks.io ping URL. You get an email if a night's backup does not arrive.
TB_GYM_BACKUP_HEARTBEAT_URL=

# ---------------------------------------------------------------------------
# Platform billing
# ---------------------------------------------------------------------------
# The Whish number coaches pay their TB Gym invoices to, as shown on the Billing page.
TB_GYM_BILLING_WHISH_NUMBER=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# USDA FoodData Central key for food search (free at api.data.gov). Empty: food search is off.
TB_GYM_USDA_API_KEY=
