<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- The real SignalR client, so the critical realtime path is exercised over an actual network
         connection with an actual cookie and an actual WebSocket handshake. Invoking hub methods
         directly, or driving them through TestServer internals, would prove the C# works and prove
         nothing about the path a browser takes. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="MSTest" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\backend\TB.Gym.Api\TB.Gym.Api.csproj" />
    <!-- The Worker's own loop is under test: a sweep that dies on an unavailable database and never
         comes back is the failure mode a durable dispatcher exists to avoid, and only the real
         BackgroundService can prove it does not. -->
    <ProjectReference Include="..\..\..\src\backend\TB.Gym.Worker\TB.Gym.Worker.csproj" />
  </ItemGroup>

</Project>
