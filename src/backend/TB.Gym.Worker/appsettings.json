{
  "Application": {
    "PublicBaseUrl": "http://localhost:4200",
    "PublicOriginAllowlist": [],
    "ActionMail": {
      "PollIntervalSeconds": 5,
      "BatchSize": 25,
      "ClaimLeaseSeconds": 120,
      "MaximumAttempts": 4,
      "SweepEnabled": true
    }
  },
  "PlatformBilling": {
    "ReferencePrefix": "TBG",
    "DueSoonReminderDays": 2,
    "SweepEnabled": true,
    "SweepIntervalSeconds": 900
  },
  "CoachCertificates": {
    "KeepMonthsAfterTakenDown": 12,
    "SweepEnabled": true,
    "SweepIntervalSeconds": 86400
  },
  "TraineeSignUps": {
    "RemoveUnconfirmedAfterDays": 2,
    "SweepEnabled": true,
    "SweepIntervalSeconds": 3600
  },
  "Notifications": {
    "Dispatch": {
      "Enabled": true,
      "PollIntervalSeconds": 5,
      "BatchSize": 25,
      "ClaimLeaseSeconds": 120,
      "MaximumAttempts": 6
    },
    "Email": {
      "Enabled": false,
      "Adapter": "None",
      "Provider": {
        "Endpoint": "https://api.resend.com/emails",
        "TimeoutSeconds": 15,
        "IdempotencyRetentionHours": 24,
        "WebhookToleranceSeconds": 300,
        "MaximumWebhookBodyBytes": 65536
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
