{
  "name": "tb-gym-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build && node scripts/inline-home-styles.mjs && npm run build:check",
    "build:check": "node --test scripts/check-prerender.test.mjs scripts/inline-home-styles.test.mjs scripts/private-preview.test.mjs scripts/home-pictures.test.mjs && node scripts/check-prerender.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "e2e": "playwright test",
    "e2e:private": "playwright test --config playwright.private.config.ts",
    "api:generate": "openapi-ts && prettier --write src/app/core/api/generated",
    "i18n:extract": "ng extract-i18n --output-path src/locale",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "ng lint && npm run lint:styles",
    "lint:styles": "node --test scripts/check-legacy-styles.test.mjs && node scripts/check-legacy-styles.mjs"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/aria": "^22.2.4",
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/localize": "22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-server": "22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/ssr": "22.2.4",
    "@microsoft/signalr": "10.0.11",
    "gsap": "^3.15.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.97.3",
    "@playwright/test": "1.63.0",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "vite": "8.3.5"
  }
}
