<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Apache-2.0, Amazon-published. The S3 client, referenced only by TB.Gym.Infrastructure so
         the provider vocabulary cannot reach a module. Cloudflare R2 speaks S3 and nothing else:
         SigV4 signing, multipart upload, ranged GET and the error shapes they return are the
         protocol, not a convenience, and hand-rolling a signer for the one credential that can
         write every workspace's media is not a place to save a dependency. -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.102.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <!-- MIT-licensed, Microsoft-published. The SignalR Redis backplane, referenced only by
         TB.Gym.Api so it never travels into the Worker image. It is required when more than one API
         replica holds hub connections: without it a frame reaches only the replica that published
         it. It is not a cache and not a source of truth — a send lost during a Redis outage is lost,
         which is why the durable event lives in PostgreSQL and catch-up can replay it. Pinned to the
         same .NET 10 patch as every other Microsoft package here. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.11" />
    <!-- MIT-licensed, Microsoft-published. The SignalR client, referenced only by the integration
         test project, so the real WebSocket path is exercised over a real network rather than
         through TestServer internals or a mocked hub context. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <!-- MIT-licensed, Microsoft-published. The generic host the Microsoft.NET.Sdk.Worker template
         requires, used by TB.Gym.Worker for BackgroundService, configuration and JSON console
         logging. Pinned to the same .NET 10 patch as every other Microsoft package here. It is the
         only dependency Phase 6B-1 added. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="MSTest" Version="4.0.2" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- MIT-licensed. Used only to re-encode uploaded progress photos so EXIF/GPS metadata cannot
         reach permanent storage. ImageSharp was rejected: its Split License requires a paid
         commercial licence for closed-source for-profit use above USD 1M revenue. -->
    <PackageVersion Include="SkiaSharp" Version="3.119.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.0" />
  </ItemGroup>
</Project>
