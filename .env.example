POSTGRES_DB=tbgym
POSTGRES_USER=tbgym
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
TB_GYM_SEED_ENABLED=false
TB_GYM_ADMIN_EMAIL=admin@tbgym.local
TB_GYM_ADMIN_PASSWORD=
Nutrition__UsdaFoodDataCentral__ApiKey=
REDIS_PORT=6380
# Realtime messaging topology. One API replica needs no backplane; more than one requires Redis and
# refuses to start without it, because otherwise each frame reaches only the replica that published
# it. Production also needs load-balancer session affinity, since transport fallback stays enabled.
TB_GYM_REALTIME_SCALE_OUT=SingleProcess
TB_GYM_API_REPLICAS=1
TB_GYM_HUB_ORIGIN=http://localhost:4200
# Transactional email. Off by default, and off in this file: the local stack has no verified sending
# domain and nothing here should be able to mail a real person by accident.
#
# Setting the adapter to Resend requires every value below. Startup refuses a half-configured
# provider whether or not the channel is enabled, because a configuration that one flag flip would
# activate is exactly the failure that validation exists to prevent.
#
# TB_GYM_EMAIL_ADAPTER: None (default), Captured (development and tests only), or Resend.
# TB_GYM_EMAIL_API_KEY: the provider API key. Never commit one; supply it from your secret store.
# TB_GYM_EMAIL_FROM: the verified sending identity, e.g. "TB Gym <notifications@mail.example.com>".
# TB_GYM_EMAIL_WEBHOOK_SECRET: the whsec_-prefixed signing secret from the provider's webhook page.
# TB_GYM_EMAIL_FINGERPRINT_KEY_ID / _KEY: the keyed address-fingerprint key new suppressions are
#   written under. The key is base64 for at least 32 random bytes. Rotate by adding a second key id
#   under Notifications__Email__Provider__FingerprintKeys__<id> and repointing the key id; keep the
#   retired key configured or the suppressions written under it stop matching and mail to addresses
#   that hard-bounced resumes.
TB_GYM_EMAIL_ENABLED=false
TB_GYM_EMAIL_ADAPTER=None
TB_GYM_EMAIL_API_KEY=
TB_GYM_EMAIL_FROM=
TB_GYM_EMAIL_WEBHOOK_SECRET=
TB_GYM_EMAIL_FINGERPRINT_KEY_ID=
TB_GYM_EMAIL_FINGERPRINT_KEY=

# ---------------------------------------------------------------------------
# Reverse proxy: whose word this deployment takes for a client's address and scheme.
# ---------------------------------------------------------------------------
# X-Forwarded-For and X-Forwarded-Proto are request headers, so they are the caller's invention
# until the address the connection came from says otherwise. Off by default, which is correct for a
# directly reachable deployment and for this local stack: nothing is honoured from anybody.
#
# Turn it on only when a reverse proxy terminates TLS in front of the API, and then name that proxy.
# Enabling it without naming one refuses startup, deliberately: forwarded headers accepted from
# nobody leave every per-address rate limit — sign-in and the provider webhook — sharing one
# partition keyed on the proxy, which is a limiter that still looks like it works while one caller
# locks out everybody.
#
# TB_GYM_TRUSTED_PROXY: one proxy address, e.g. the address the edge connects from.
# TB_GYM_TRUSTED_PROXY_NETWORK: a CIDR network, for an edge whose address is assigned rather than
#   fixed. Keep it as small as the deployment allows; every address inside it may rewrite the client
#   address of every request it sends. A zero-length prefix (0.0.0.0/0, ::/0) is refused.
# For more than one of either, set the indexed keys directly:
#   ReverseProxy__TrustedProxies__1, ReverseProxy__TrustedNetworks__1, and so on.
#
# The framework additionally trusts loopback (::1 and 127.0.0.0/8) and that is deliberately left in
# place, so the API must be bound to a private interface and never be reachable directly.
TB_GYM_REVERSE_PROXY_ENABLED=false
TB_GYM_TRUSTED_PROXY=
TB_GYM_TRUSTED_PROXY_NETWORK=

# ---------------------------------------------------------------------------
# Action mail: account confirmation, password reset and client invitations.
# ---------------------------------------------------------------------------
# The single origin every action link is built from, and the allowlist it must appear in. Both the
# API and the Worker validate it at startup and refuse to run without a usable value; neither ever
# takes an origin from a request header, because a host-header injection turns a password-reset mail
# into a credential-harvesting mail the victim's own account triggered.
#
# Outside Development this must be HTTPS. Credentials, a query string, a fragment and any path are
# refused: a base URL carrying a path is how a lookalike link gets built out of a real setting.
TB_GYM_PUBLIC_ORIGIN=http://localhost:4200

# How many durable materializations one action-mail request gets before it is dead-lettered. Small
# on purpose: every attempt mints a fresh live credential, and a confirmation or reset link that
# nobody used within the schedule is one the person has already asked for again.
TB_GYM_ACTION_MAIL_MAX_ATTEMPTS=4
TB_GYM_ACTION_MAIL_POLL_SECONDS=5
TB_GYM_ACTION_MAIL_BATCH_SIZE=25
TB_GYM_ACTION_MAIL_LEASE_SECONDS=120

# ---------------------------------------------------------------------------
# Media storage and upload scanning.
# ---------------------------------------------------------------------------
# The local stack keeps object bytes in a container volume and uses the allow-everything development
# scanner, because that is what a development machine can compose without a Cloudflare account.
#
# TB_GYM_MEDIA_STORAGE_ADAPTER: Local (Development only), R2, or None. Selecting R2 requires every
#   value below and refuses startup without them. The bucket is private, in the EU jurisdiction, and
#   the credential is scoped to that one bucket with Object Read and Write. The durable location
#   name r2-eu-v1 permanently binds one account, jurisdiction and bucket: repointing these settings
#   at a different bucket would make every stored locator name bytes that are not theirs, so moving
#   buckets is a migration and never a configuration edit.
# TB_GYM_R2_ACCESS_KEY_ID / _SECRET_ACCESS_KEY: never commit these; supply them from your secret
#   store. They can write and read every workspace's media.
TB_GYM_MEDIA_STORAGE_ADAPTER=Local
TB_GYM_R2_ACCOUNT_ID=
TB_GYM_R2_BUCKET=
TB_GYM_R2_ACCESS_KEY_ID=
TB_GYM_R2_SECRET_ACCESS_KEY=

# TB_GYM_MEDIA_SCANNER_ADAPTER: Development (Development only, allows everything), ClamAv, or None.
# Set it to ClamAv to use the clamav service in compose.yaml, which runs unprivileged on the private
# network with the limits in docker/clamav/clamd.conf. Uploads are refused while the scanner is
# unavailable, and readiness reports media as degraded rather than failing the whole API.
TB_GYM_MEDIA_SCANNER_ADAPTER=Development

# The engine holds its whole signature database in memory. Below roughly 4 GiB the daemon is killed
# part-way through loading, which presents as uploads that time out rather than as a failed
# container. Signature updates are checked this many times a day.
TB_GYM_CLAMAV_MEMORY=4g
TB_GYM_CLAMAV_FRESHCLAM_CHECKS=2
